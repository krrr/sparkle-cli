{
	"compilerOptions": {
		"outDir": "build",
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"jsx": "react",
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src"],
	"ts-node": {
		"transpileOnly": true,
		"files": true,
		"experimentalResolver": true,
		"experimentalSpecifierResolution": "node"
	}
}
